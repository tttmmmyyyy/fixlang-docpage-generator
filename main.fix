module Main;

import EZS;
import Generate;
import Json.Decode;
import Records;
import Site;
import Store;

// Brings the store in `store/` up to date, lays it out as the MkDocs pages in `docs/` with the
// configuration `mkdocs.site.yml`, and writes what went wrong into `failures.txt`, which is empty
// when nothing did.
//
// A failure is written into `failures.txt` rather than ending the program, so that the pages of
// every other package are still brought up to date.
main : IO ();
main = (
    let ctx = Context::default.set_eprint_stderr(true).set_execution_trace(true);
    let root = *ctx.cwd;
    let store = Store { root : root + "/store" };

    let packages = *ctx.run_o(["fix", "deps", "list", "--json"]);
    let packages = Package::read_list.decode(packages);
    if packages.is_err {
        exit_with_msg(1, "error: failed to parse the output of `fix deps list --json`: " + packages.as_err)
    };
    let packages = packages.as_ok;

    let compiler = (*ctx.run_o(["fix", "--version"])).strip_spaces;
    let date = (*ctx.run_o(["date", "-u", "+%Y-%m-%d"])).strip_spaces;
    let run = Run { ctx : ctx, root : root, store : store, compiler : compiler, date : date };

    let problems = *update_std(run);
    let problems = *packages.to_iter.fold_m(problems, |package, problems|
        let found = *update_package(package, run);
        pure $ problems.append(found)
    );
    ctx.cd(root);;
    let found = *render(packages, root + "/docs", root + "/mkdocs.site.yml", store, ctx);
    let problems = problems.append(found);

    let report = problems.to_iter.map(|problem| problem + "\n").concat_iter;
    write_file_string(root + "/failures.txt", report).try(exit_with_msg(1));;
    if problems.is_empty { println("Done.") };
    eprintln("Done, with failures:\n" + report)
);
