// The documentation kept from one run to the next.
//
// The directory is laid out as:
//
// ```
// packages/<package>/failure.json                     the last run failed before it reached a tag
// packages/<package>/<version>/generation.json        the saved documentation of the version
// packages/<package>/<version>/modules/<Module>.md
// packages/<package>/<version>/failure.json           the last attempt at the version failed
// std/<version>/generation.json                       <version> is `main` or a release
// std/<version>/Std.md
// ```
//
// A version directory holds a failure record, saved documentation, or both: documentation saved by
// an earlier attempt stays when a later one fails.
module Store;

import EZS::{run_o, Context};
import Json.Decode::{Decoder, Decoder::decode};
import Records::{Failure, Generation, Failure::{read, write}, Generation::{read, write}};
import Semver::{Version, Version::parse_tag};
import Std::{
    Array, IO, Option, String, Array::{sort_by, to_iter}, Functor::forget, 
    IO::{exit_with_msg, read_file_string, write_file_string, IOFail::{to_result, try}}, 
    Iterator::{filter, filter_map, to_array}, Monad::pure, Option::{none, some}, 
    Result::{as_err, as_ok, is_err}, String::{is_empty, split}, ToString::to_string
};

type Store = struct {
    // The absolute path of the directory.
    root : String
};

namespace Store {
    // The directory of a package.
    //
    // # Parameters
    // * `name` - The name of the package.
    // * `store` - The store.
    package_dir : String -> Store -> String = |name, store| store.@root + "/packages/" + name;

    // The directory of a version of a package.
    //
    // # Parameters
    // * `name` - The name of the package.
    // * `version` - The version.
    // * `store` - The store.
    version_dir : String -> Version -> Store -> String = |name, version, store| store.package_dir(name) + "/" + version.to_string;

    // The directory of a version of `Std`, which is `main` or a release.
    //
    // # Parameters
    // * `version` - `main` or the release.
    // * `store` - The store.
    std_dir : String -> Store -> String = |version, store| store.@root + "/std/" + version;

    // The versions of a package that have a directory, highest first.
    //
    // # Parameters
    // * `name` - The name of the package.
    // * `ctx` - The context to run commands in.
    // * `store` - The store.
    package_versions : String -> Context -> Store -> IO (Array Version) = |name, ctx, store| (
        let names = *list_dirs(store.package_dir(name), ctx);
        pure $ names.to_iter.filter_map(Version::parse_tag).to_array.sort_by(|(a, b)| b < a)
    );

    // The releases of `Std` that have a directory, highest first.
    //
    // # Parameters
    // * `ctx` - The context to run commands in.
    // * `store` - The store.
    std_releases : Context -> Store -> IO (Array Version) = |ctx, store| (
        let names = *list_dirs(store.@root + "/std", ctx);
        pure $ names.to_iter.filter(|name| name != "main").filter_map(Version::parse_tag).to_array.sort_by(|(a, b)| b < a)
    );
}

// The names of the directories directly under `dir`, which is created where it is missing.
//
// # Parameters
// * `dir` - The directory to look in.
// * `ctx` - The context to run commands in.
list_dirs : String -> Context -> IO (Array String) = |dir, ctx| (
    ctx.run_o(["mkdir", "-p", dir]);;
    let out = *ctx.run_o(["find", dir, "-mindepth", "1", "-maxdepth", "1", "-type", "d", "-printf", "%f\n"]);
    pure $ out.split("\n").filter(|line| !line.is_empty).to_array
);

// The saved documentation record in `dir`, if there is one.
//
// # Parameters
// * `dir` - The version directory.
read_generation : String -> IO (Option Generation) = |dir| _read_record(dir + "/generation.json", Generation::read);

// The failure record in `dir`, if there is one.
//
// # Parameters
// * `dir` - The package or version directory.
read_failure : String -> IO (Option Failure) = |dir| _read_record(dir + "/failure.json", Failure::read);

// Saves the documentation record in `dir`, and removes the failure record there.
//
// # Parameters
// * `generation` - The record.
// * `dir` - The version directory.
// * `ctx` - The context to run commands in.
write_generation : Generation -> String -> Context -> IO () = |generation, dir, ctx| (
    write_file_string(dir + "/generation.json", generation.write).try(exit_with_msg(1));;
    remove_failure(dir, ctx)
);

// Saves the failure record in `dir`.
//
// # Parameters
// * `failure` - The record.
// * `dir` - The package or version directory.
// * `ctx` - The context to run commands in.
write_failure : Failure -> String -> Context -> IO () = |failure, dir, ctx| (
    ctx.run_o(["mkdir", "-p", dir]);;
    write_file_string(dir + "/failure.json", failure.write).try(exit_with_msg(1))
);

// Removes the failure record in `dir`, if there is one.
//
// # Parameters
// * `dir` - The package or version directory.
// * `ctx` - The context to run commands in.
remove_failure : String -> Context -> IO () = |dir, ctx| ctx.run_o(["rm", "-f", dir + "/failure.json"]).forget;

// Reads the record at `path`, or answers with `none` where there is no file. A file that does not
// read as the record ends the program, since the store would be left in a state no run expects.
//
// # Parameters
// * `path` - The path of the record.
// * `decoder` - The reading of the record.
_read_record : String -> Decoder a -> IO (Option a) = |path, decoder| (
    let text = *read_file_string(path).to_result;
    if text.is_err { pure $ none() };
    let record = decoder.decode(text.as_ok);
    if record.is_err { exit_with_msg(1, "error: failed to read \"" + path + "\": " + record.as_err) };
    pure $ some(record.as_ok)
);
